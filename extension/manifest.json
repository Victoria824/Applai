{
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Applai",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/sw.js"
  },
  "content_scripts": [
    {
      "js": [
        "content/lib/match.js",
        "content/lib/combobox.js",
        "content/ats.js",
        "content/fill.js",
        "content/captcha.js",
        "content/submit.js",
        "content/bridge.js",
        "content/connect.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "原型：在公司官网职位页自动填写申请表单，验证码任务进队列并手机推送提醒。",
  "host_permissions": [
    "<all_urls>"
  ],
  "manifest_version": 3,
  "name": "Applai — 求职自动投递",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "notifications",
    "alarms"
  ],
  "version": "0.2.1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}